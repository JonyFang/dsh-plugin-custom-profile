  },
  "homepage": "https://github.com/JonyFang/dsh-plugin-custom-profile#readme",
  "bugs": {
    "url": "https://github.com/JonyFang/dsh-plugin-custom-profile/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
